#!/bin/sh
set -e

VW_USER=viewwall
VW_CONF=/etc/viewwall

case "$1" in
configure)
    # A system user rather than a login account: the wall needs the video and
    # render groups for DRM and V4L2, and nothing else.
    if ! getent passwd "$VW_USER" >/dev/null; then
        adduser --system --group --no-create-home \
                --home /nonexistent --shell /usr/sbin/nologin \
                --gecos "Viewwall camera wall" "$VW_USER"
    fi
    for grp in video render; do
        if getent group "$grp" >/dev/null; then
            adduser "$VW_USER" "$grp" >/dev/null 2>&1 || true
        fi
    done

    install -d -m 0755 -o "$VW_USER" -g "$VW_USER" "$VW_CONF"

    # RTSP URIs embed credentials, so the configuration is private and is not
    # a conffile: an upgrade must never prompt about it or overwrite it.
    if [ ! -e "$VW_CONF/viewwall.toml" ]; then
        install -m 0600 -o "$VW_USER" -g "$VW_USER" \
            /usr/share/viewwall/viewwall.toml "$VW_CONF/viewwall.toml"
    fi

    # Adopt configuration from an earlier hand-rolled install that ran as a
    # different user, so upgrading in place does not silently lose access.
    chown -R "$VW_USER":"$VW_USER" "$VW_CONF" || true

    echo "Configure /etc/viewwall/viewwall.toml, then:"
    echo "  systemctl enable --now viewwall"
    ;;
esac

#DEBHELPER#

exit 0
