[Unit]
Description=DRM/KMS camera wall
After=network-online.target
Wants=network-online.target
# A wall that keeps restarting still shows every healthy camera between
# restarts, so it never gives up: a stopped unit shows nothing at all, and the
# faults that get this far have only ever affected one feed. The backoff below
# keeps a wall that cannot stay up from cycling every few seconds.
StartLimitIntervalSec=0

[Service]
Type=notify
NotifyAccess=main
User=viewwall
Group=viewwall
SupplementaryGroups=video render
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GST_REGISTRY_1_0=/var/cache/viewwall/registry.bin
Environment=XDG_CACHE_HOME=/var/cache/viewwall
ExecStart=/usr/bin/viewwall --config /etc/viewwall/viewwall.toml run
Restart=always
# 5s before the first restart, growing over five steps to a minute if they
# keep coming (measured: 5, 8, 14, 23, 36, 60). A transient fault recovers as
# fast as it always did; a persistent one stops hammering the decoder and
# filling the journal. Older systemd ignores the two ramp settings and retries
# at a flat 5s, which is why that floor is not lower.
RestartSec=5
RestartSteps=5
RestartMaxDelaySec=60
WatchdogSec=30
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal

# The service only needs the DRM, V4L2, configuration, and network surfaces.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/viewwall
CacheDirectory=viewwall
DevicePolicy=closed
# DRM (char 226) for the output planes and V4L2 (char 81) for the hardware
# decoders. Allowed by class rather than by node so a different card number or
# decoder node still works.
DeviceAllow=char-drm rw
DeviceAllow=char-video4linux rw

[Install]
WantedBy=multi-user.target
